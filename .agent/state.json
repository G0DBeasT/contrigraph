  "decisions": [
    {
      "id": "DEC-001",
      "topic": "Technology Selection",
      "decision": "Python 3.10+ using standard library argparse for CLI parsing, Rich for terminal rendering and styling, httpx for HTTP/GraphQL API with standard library fallback, and dataclasses/pydantic for models.",
      "rationale": "Portability on Fedora/Linux/macOS/Windows, high-performance terminal UI, zero fragile binary dependencies."
    },
    {
      "id": "DEC-002",
      "topic": "Package and CLI Names",
      "decision": "Package named 'contrigraph' with entrypoints 'ghcontrib', 'contrigraph', and 'github-contrib'.",
      "rationale": "Supports flexible invocation styles."
    },
    {
      "id": "DEC-003",
      "topic": "GitHub API Mechanism",
      "decision": "GitHub GraphQL API v4 (contributionsCollection and contributionCalendar).",
      "rationale": "Official, exact 1-year matrix with official quartile densities and zero web scraping."
    },
    {
      "id": "DEC-004",
      "topic": "Credential Isolation",
      "decision": "Separate config.json (user preferences) from auth.json (token credentials) with strict 0600 POSIX permissions.",
      "rationale": "Security best practice to prevent leaking tokens in shared or copied configurations."
    },
    {
      "id": "DEC-005",
      "topic": "Responsive Terminal Rendering",
      "decision": "Automatic dual-mode: continuous 53-week matrix on >=110 cols, split 6-month matrices on <110 cols.",
      "rationale": "Prevents line wrapping corruption on standard 80-column terminals while leveraging full width on modern large terminal windows."
    }
  ],
  "architecture_decisions": [
    "Modular architecture with strict boundary interfaces",
    "Data models decoupled from rendering logic",
    "Independent statistics calculation engine",
    "Two-tier caching strategy (temporary current year, immutable past years)",
    "XDG-compliant storage with cross-platform fallback"
  ],
